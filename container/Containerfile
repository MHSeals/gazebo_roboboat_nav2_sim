# ROS 2 Jazzy + Gazebo Harmonic on Ubuntu 24.04 — the platform roboboat_sim targets.
#
# Built for rootless podman on an Arch host whose running kernel cannot load
# modules (upgraded-but-not-rebooted), so: host networking, no bridge, no nat.
FROM docker.io/osrf/ros:jazzy-desktop

SHELL ["/bin/bash", "-c"]

# The package set from README.md "Once you have a machine", plus the bits the
# tools/ scripts shell out to (ffmpeg for make_video, psmisc for the teardown).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-navigation2 \
      ros-jazzy-nav2-bringup \
      ros-jazzy-nav2-mppi-controller \
      ros-jazzy-nav2-smac-planner \
      ros-jazzy-ros-gz \
      ros-jazzy-xacro \
      ros-jazzy-robot-state-publisher \
      python3-colcon-common-extensions \
      python3-pytest \
      python3-numpy \
      python3-yaml \
      libgl1-mesa-dri \
      mesa-utils \
      ffmpeg \
      procps \
      psmisc \
    && rm -rf /var/lib/apt/lists/*

# The GPU lidar needs a GL context even headless. Software rendering is how the
# project's own benchmark numbers were taken, and it sidesteps any host/container
# Mesa mismatch on the first run.
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV QT_X11_NO_MITSHM=1

WORKDIR /ws
