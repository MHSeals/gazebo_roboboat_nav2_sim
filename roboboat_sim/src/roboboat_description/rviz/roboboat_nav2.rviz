Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Costmaps1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 30; 40; 52
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
      Color: 60; 80; 100
      Alpha: 0.35
      Reference Frame: map
    - Class: rviz_default_plugins/RobotModel
      Name: Boat
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.15
      Style: Spheres
      Color: 255; 200; 60
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz_common/Group
      Name: Costmaps
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Topic:
            Value: /global_costmap/costmap
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Color Scheme: costmap
          Alpha: 0.35
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Topic:
            Value: /local_costmap/costmap
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Color Scheme: costmap
          Alpha: 0.7
        - Class: rviz_default_plugins/Polygon
          Name: Footprint
          Enabled: true
          Topic:
            Value: /local_costmap/published_footprint
            Depth: 5
            Durability Policy: Volatile
            Reliability Policy: Reliable
          Color: 60; 220; 120
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 80; 180; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: MPPI Considered Plan
      Enabled: true
      Topic:
        Value: /transformed_global_plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 120; 200
      Line Style: Lines
    - Class: rviz_default_plugins/MarkerArray
      Name: MPPI Trajectories
      # Requires FollowPath.visualize:=true, which costs real compute.
      Enabled: false
      Topic:
        Value: /trajectories
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Thrust Vectors
      Enabled: true
      Topic:
        Value: /thrusters/markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 100
      Shape:
        Alpha: 0.6
        Color: 255; 85; 0
        Shaft Length: 0.6
        Shaft Radius: 0.06
        Head Length: 0.2
        Head Radius: 0.12
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Pitch: 1.1
      Yaw: 3.6
      Focal Point:
        X: 18
        Y: 14
        Z: 0
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
